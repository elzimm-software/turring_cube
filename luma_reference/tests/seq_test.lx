@module "seq_tests"

@use "std_libc"  as libc
@use "std_time"  as time

@use "layer" as layer
@use "tape"  as tape
@use "viz"   as viz

// ─────────────────────────────────────────────────────────────────────────────
// SEQUENTIAL MEMORY TEST
//
// The network is shown a sequence of N values one at a time.
// At each step it receives the current value as input and must output
// the value it saw ONE STEP AGO.
//
// Example (seq_len = 4):
//   Step 0  in=0.8  target=0.0  (no previous value — target is 0)
//   Step 1  in=0.2  target=0.8
//   Step 2  in=0.9  target=0.2
//   Step 3  in=0.5  target=0.9
//
// A plain MLP with no memory cannot solve this — it would need to remember
// the previous input across forward passes. The tape + state give the network
// exactly the memory it needs to do so.
//
// Training: the tape and state are NOT reset between steps within a sequence.
// They ARE reset between sequences so each episode starts clean.
// Backprop is run at every step (online, not BPTT).
// ─────────────────────────────────────────────────────────────────────────────

const SEQ_LEN:    int = 6;
const NUM_SEQS:   int = 8;
const INPUT_SIZE: int = 1;

// Fill seqs[NUM_SEQS][SEQ_LEN] with values in (0,1).
// keep away from 0 and 1 so sigmoid outputs have room to be right.
const gen_sequences -> fn (seqs: *double) void {
    let n: int = NUM_SEQS * SEQ_LEN;
    loop [i: int = 0](i < n) : (++i) {
        seqs[i] = 0.1 + 0.8 * (cast<double>(libc::rand()) / 2147483647.0);
    }
}

const eval_seq_loss -> fn (
    head:        *TapeLayer,
    output_tl:   *TapeLayer,
    seq:         *double
) double {
    let total: double = 0.0;

    loop [step: int = 0](step < SEQ_LEN) : (++step) {
        let val:    double = seq[step];
        let target: double = 0.0;
        if (step > 0) target = seq[step - 1];

        let t: [double; 1] = [target];
        tape::run_tape_forward(head, &val, INPUT_SIZE);
        tape::run_tape_backward(output_tl, &t[0]);
        tape::run_tape_update(head, 0.0);

        let act:  *double = output_tl.outputs_begin();
        let diff: double  = act[0] - target;
        total = total + diff * diff;
    }

    head.reset();
    output_tl.reset();
    return total / cast<double>(SEQ_LEN);
}

const show_seq_step -> fn (
    hidden:    *TapeLayer,
    output_tl: *TapeLayer,
    h_trail:   *HeadTrail,
    o_trail:   *HeadTrail,
    step:      int,
    val:     double,
    target:    double,
    pred:      double,
    epoch:     int,
    epochs:    int,
    loss:      double,
    prev_loss: double
) void {
     output("\x1b[2J\x1b[H");

    output(viz::BOLD);
    output("╔══════════════════════════════════════════╗\n");
    output("║       Tape Net — Sequential Memory        ║\n");
    output("╚══════════════════════════════════════════╝\n");
    output(viz::RESET);
    output("\n");

    viz::show_epoch(epoch, epochs);
    viz::show_loss(loss, prev_loss);
    output("\n");

    // Step counter bar
    output("  Step ");
    output(step + 1);
    output(" / ");
    output(SEQ_LEN);
    output("   In: ");
    viz::print_fixed2(val);
    output("   Target (prev): ");
    viz::print_fixed2(target);
    output("   Pred: ");
    let pass: bool = (pred > 0.5) == (target > 0.5);
    if (pass) output(viz::FG_GREEN); else output(viz::FG_RED);
    viz::print_fixed2(pred);
    output(viz::RESET);
    output("\n\n");

    viz::show_tape_grid(&hidden.tape,    h_trail, "Hidden Tape ");
    viz::show_state(hidden.state, hidden.state_dim);
    output("\n");

    viz::show_tape_grid(&output_tl.tape, o_trail, "Output Tape ");
    viz::show_state(output_tl.state, output_tl.state_dim);
    output("\n");
}

const print_recall_table -> fn (
    head:      *TapeLayer,
    output_tl: *TapeLayer,
    seqs:      *double,
    n_seqs:    int
) void {
    output("\n  Recall Table (last ", n_seqs, " sequences):\n");
    output("╔════════╦");
    loop [s: int = 0](s < SEQ_LEN) : (++s) { output("══════════╦"); }
    output("═══════╗\n");

    output("║  seq   ║");
    loop [s: int = 0](s < SEQ_LEN) : (++s) {
        output("  step ", s, "  ║");
    }
    output(" pass? ║\n");
    output("╠════════╬");
    loop [s: int = 0](s < SEQ_LEN) : (++s) { output("══════════╬"); }
    output("═══════╣\n");

    loop [q: int = 0](q < n_seqs) : (++q) {
        let seq: *double = &seqs[q * SEQ_LEN];
        let all_pass: bool = true;

        output("║  [", q, "]   ║");
        loop [step: int = 0](step < SEQ_LEN) : (++step) {
            let val:    double = seq[step];
            let target: double = 0.0;
            if (step > 0) target = seq[step - 1];

            let t: [double; 1] = [target];
            tape::run_tape_forward(head, &val, INPUT_SIZE);
            let act:  *double = output_tl.outputs_begin();
            let pred: double  = act[0];
            tape::run_tape_backward(output_tl, &t[0]);
            tape::run_tape_update(head, 0.0);

            // For step 0 we don't score (target is 0 by convention, not meaningful)
            if (step == 0) {
                output("   --     ║");
            } else {
                let err: double = pred - target;
                if (err < 0.0) err = -err;
                let close: bool = err < 0.15;
                if (close == false) all_pass = false;
                if (close) output(viz::FG_GREEN); else output(viz::FG_RED);
                output(" ");
                viz::print_fixed2(pred);
                output("/");
                viz::print_fixed2(target);
                output(viz::RESET);
                output(" ║");
            }
        }

        if (all_pass) { output(viz::FG_GREEN); output("  PASS "); }
        else          { output(viz::FG_RED);   output("  FAIL "); }
        output(viz::RESET);
        output("║\n");

        head.reset();
        output_tl.reset();
    }

    output("╚════════╩");
    loop [s: int = 0](s < SEQ_LEN) : (++s) { output("══════════╩"); }
    output("═══════╝\n");
}

pub const test_seq_memory -> fn () void {
    let hidden_size: int    = 16;
    let state_dim:   int    = 4;
    let tape_width:  int    = 8;
    let epochs:      int    = 800;
    let lr:          double = 5.0;

    let hidden:    TapeLayer = tape::init_tape_layer(INPUT_SIZE, hidden_size, state_dim, tape_width);
    let output_tl: TapeLayer = tape::init_tape_layer(hidden_size, 1,          state_dim, tape_width);

    defer {
        tape::free_tape_layer(&hidden);
        tape::free_tape_layer(&output_tl);
    }
    
    hidden.layer.init_weights_biases();
    output_tl.layer.init_weights_biases();
    hidden.next_tape = &output_tl;
    tape::link_tape_layers(&hidden);

    let seqs: *double = cast<*double>(alloc(NUM_SEQS * SEQ_LEN * sizeof<double>));
    gen_sequences(seqs);
    defer { free(seqs); }

    let h_trail:   HeadTrail = viz::init_trail();
    let o_trail:   HeadTrail = viz::init_trail();
    let prev_loss: double    = -1.0;

 loop [epoch: int = 0](epoch < epochs) : (++epoch) {
        loop [q: int = 0](q < NUM_SEQS) : (++q) {
            let seq: *double = &seqs[q * SEQ_LEN];

            loop [step: int = 0](step < SEQ_LEN) : (++step) {
                let val:  double = seq[step];
                let target: double = 0.0;
                if (step > 0) target = seq[step - 1];

                let t: [double; 1] = [target];
                tape::run_tape_forward(&hidden, &val, INPUT_SIZE);
                tape::run_tape_backward(&output_tl, &t[0]);
                tape::run_tape_update(&hidden, lr);

                h_trail.push(hidden.tape.head_x,    hidden.tape.head_y);
                o_trail.push(output_tl.tape.head_x, output_tl.tape.head_y);
            }

            hidden.reset();
            output_tl.reset();
        }

        if (epoch % 500 == 0) {
            let seq: *double = &seqs[0];
            let loss: double = eval_seq_loss(&hidden, &output_tl, seq);

            loop [step: int = 0](step < SEQ_LEN) : (++step) {
                let val:    double = seq[step];
                let target: double = 0.0;
                if (step > 0) target = seq[step - 1];

                let t: [double; 1] = [target];
                tape::run_tape_forward(&hidden, &val, INPUT_SIZE);

                let act:  *double = output_tl.outputs_begin();
                let pred: double  = act[0];

                show_seq_step(
                    &hidden, &output_tl, &h_trail, &o_trail,
                    step, val, target, pred,
                    epoch, epochs, loss, prev_loss
                );
                time::usleep(5000);

                tape::run_tape_backward(&output_tl, &t[0]);
                tape::run_tape_update(&hidden, 0.0);
            }

            prev_loss = loss;
            hidden.reset();
            output_tl.reset();
        }
    }

    print_recall_table(&hidden, &output_tl, seqs, NUM_SEQS);
}
