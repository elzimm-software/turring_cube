@module "seq_tests"

@use "std_arena" as arena
@use "std_libc"  as libc
@use "std_time"  as time

@use "layer" as layer
@use "tape"  as tape
@use "viz"   as viz

const SEQ_LEN:    int = 8;
const NUM_SEQS:   int = 10;
const INPUT_SIZE: int = 4;

const gen_sequences -> fn (seqs: *double) void {
    let n: int = NUM_SEQS * SEQ_LEN;
    loop [i: int = 0](i < n) : (++i) {
        seqs[i] = 0.1 + 0.8 * (cast<double>(libc::rand()) / 2147483647.0);
    }
}

const eval_seq_loss -> fn (
    head:        *TapeLayer,
    hidden_2:    *TapeLayer,
    output_tl:   *TapeLayer,
    seq:         *double
) double {
    let total: double = 0.0;

    loop [step: int = 0](step < SEQ_LEN) : (++step) {
        let val:    double = seq[step];
        let target: double = 0.0;
        if (step > 0) target = seq[step - 1];

        tape::run_tape_forward(head, &val, INPUT_SIZE);

        let act:  *double = output_tl.outputs_begin();
        let diff: double  = act[0] - target;
        total = total + diff * diff;
    }

    head.reset();
    hidden_2.reset();
    output_tl.reset();
    return total / cast<double>(SEQ_LEN);
}

const show_seq_step -> fn (
    hidden:    *TapeLayer,
    hidden_2:  *TapeLayer,
    output_tl: *TapeLayer,
    h_trail:   *HeadTrail,
    h2_trail:  *HeadTrail,
    o_trail:   *HeadTrail,
    step:      int,
    val:       double,
    target:    double,
    pred:      double,
    epoch:     int,
    epochs:    int,
    loss:      double,
    prev_loss: double
) void {
    output("\x1b[2J\x1b[H");

    output(viz::BOLD);
    output("╔══════════════════════════════════════════╗\n");
    output("║       Tape Net — Sequential Memory        ║\n");
    output("╚══════════════════════════════════════════╝\n");
    output(viz::RESET);
    output("\n");

    viz::show_epoch(epoch, epochs);
    viz::show_loss(loss, prev_loss);
    output("\n");

    output("  Step ");
    output(step + 1);
    output(" / ");
    output(SEQ_LEN);
    output("   In: ");
    viz::print_fixed2(val);
    output("   Target (prev): ");
    viz::print_fixed2(target);
    output("   Pred: ");
    let pass: bool = (pred > 0.5) == (target > 0.5);
    if (pass) output(viz::FG_GREEN); else output(viz::FG_RED);
    viz::print_fixed2(pred);
    output(viz::RESET);
    output("\n\n");

    viz::show_tape_grid(&hidden.tape,   h_trail,  "Hidden 1    ");
    viz::show_state(hidden.state, hidden.state_dim);
    output("\n");

    viz::show_tape_grid(&hidden_2.tape, h2_trail, "Hidden 2    ");
    viz::show_state(hidden_2.state, hidden_2.state_dim);
    output("\n");

    viz::show_tape_grid(&output_tl.tape, o_trail, "Output Tape ");
    viz::show_state(output_tl.state, output_tl.state_dim);
    output("\n");
}

const print_recall_table -> fn (
    head:      *TapeLayer,
    hidden_2:  *TapeLayer,
    output_tl: *TapeLayer,
    seqs:      *double,
    n_seqs:    int
) void {
    output("\n  Recall Table (", n_seqs, " sequences):\n");
    output("╔════════╦");
    loop [s: int = 0](s < SEQ_LEN) : (++s) { output("══════════╦"); }
    output("═══════╗\n");

    output("║  seq   ║");
    loop [s: int = 0](s < SEQ_LEN) : (++s) { output("  step ", s, "  ║"); }
    output(" pass? ║\n");

    output("╠════════╬");
    loop [s: int = 0](s < SEQ_LEN) : (++s) { output("══════════╬"); }
    output("═══════╣\n");

    loop [q: int = 0](q < n_seqs) : (++q) {
        let seq: *double = &seqs[q * SEQ_LEN];
        let all_pass: bool = true;

        output("║  [", q, "]   ║");
        loop [step: int = 0](step < SEQ_LEN) : (++step) {
            let val:    double = seq[step];
            let target: double = 0.0;
            if (step > 0) target = seq[step - 1];

            let t: [double; 1] = [target];
            tape::run_tape_forward(head, &val, INPUT_SIZE);
            let act:  *double = output_tl.outputs_begin();
            let pred: double  = act[0];

            if (step == 0) {
                output("   --     ║");
            } else {
                let err: double = pred - target;
                if (err < 0.0) err = -err;
                let close: bool = err < 0.15;
                if (close == false) all_pass = false;
                if (close) output(viz::FG_GREEN); else output(viz::FG_RED);
                output(" ");
                viz::print_fixed2(pred);
                output("/");
                viz::print_fixed2(target);
                output(viz::RESET);
                output(" ║");
            }
        }

        if (all_pass) { output(viz::FG_GREEN); output("  PASS "); }
        else          { output(viz::FG_RED);   output("  FAIL "); }
        output(viz::RESET);
        output("║\n");

        head.reset();
        hidden_2.reset();
        output_tl.reset();
    }

    output("╚════════╩");
    loop [s: int = 0](s < SEQ_LEN) : (++s) { output("══════════╩"); }
    output("═══════╝\n");
}

pub const test_seq_memory -> fn () void {
    let hidden_size: int    = 32;
    let state_dim:   int    = 4;
    let tape_width:  int    = 8;
    let epochs:      int    = 20000;
    let lr:          double = 0.3;

    let buffer: Arena = arena::create_arena();
    let hidden:    TapeLayer = tape::init_tape_layer(INPUT_SIZE,   hidden_size, state_dim, tape_width, &buffer);
    let hidden_2:  TapeLayer = tape::init_tape_layer(hidden_size,  hidden_size, state_dim, tape_width, &buffer);
    let output_tl: TapeLayer = tape::init_tape_layer(hidden_size,  1,           state_dim, tape_width, &buffer);
    defer { arena::free_arena(&buffer); }

    hidden.layer.init_weights_biases();
    hidden_2.layer.init_weights_biases();
    output_tl.layer.init_weights_biases();

    hidden.next_tape   = &hidden_2;
    hidden_2.next_tape = &output_tl;

    tape::link_tape_layers(&hidden);

    let seqs: *double = cast<*double>(alloc(NUM_SEQS * SEQ_LEN * sizeof<double>));
    gen_sequences(seqs);
    defer { free(seqs); }

    let h_trail:   HeadTrail = viz::init_trail();
    let h2_trail:  HeadTrail = viz::init_trail();
    let o_trail:   HeadTrail = viz::init_trail();
    let prev_loss: double    = -1.0;

    loop [epoch: int = 0](epoch < epochs) : (++epoch) {
        loop [q: int = 0](q < NUM_SEQS) : (++q) {
            let seq: *double = &seqs[q * SEQ_LEN];

            loop [step: int = 0](step < SEQ_LEN) : (++step) {
                let val:    double = seq[step];
                let target: double = 0.0;
                if (step > 0) target = seq[step - 1];

                let t: [double; 1] = [target];
                tape::run_tape_forward(&hidden, &val, INPUT_SIZE);
                tape::run_tape_backward(&output_tl, &t[0]);
                tape::run_tape_update(&hidden, lr);

                h_trail.push(hidden.tape.head_x,    hidden.tape.head_y);
                h2_trail.push(hidden_2.tape.head_x, hidden_2.tape.head_y);
                o_trail.push(output_tl.tape.head_x, output_tl.tape.head_y);
            }

            hidden.reset();
            hidden_2.reset();
            output_tl.reset();
        }

        if (epoch % 100 == 0) {
            let seq: *double = &seqs[0];
            let loss: double = eval_seq_loss(&hidden, &hidden_2, &output_tl, seq);

            loop [step: int = 0](step < SEQ_LEN) : (++step) {
                let val:    double = seq[step];
                let target: double = 0.0;
                if (step > 0) target = seq[step - 1];

                let t: [double; 1] = [target];
                tape::run_tape_forward(&hidden, &val, INPUT_SIZE);

                let act:  *double = output_tl.outputs_begin();
                let pred: double  = act[0];

                show_seq_step(
                    &hidden, &hidden_2, &output_tl,
                    &h_trail, &h2_trail, &o_trail,
                    step, val, target, pred,
                    epoch, epochs, loss, prev_loss
                );
            }

            prev_loss = loss;
            hidden.reset();
            hidden_2.reset();
            output_tl.reset();
        }
    }

    print_recall_table(&hidden, &hidden_2, &output_tl, seqs, NUM_SEQS);
}
